# ── 필수 ──────────────────────────────────────────────
# Supabase PostgreSQL 접속 문자열 (myportal 스키마는 마이그레이션이 생성)
DATABASE_URL=

# Supabase 프로젝트 (매직링크 발송에 Supabase Auth 사용 시 필요)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 앱 기본 URL (매직링크 콜백, 크롤러 UA 식별에 사용)
APP_BASE_URL=http://localhost:3001

# 프론트엔드 API base URL
NEXT_PUBLIC_API_URL=http://localhost:3001/api

LOG_LEVEL=info

# ── 인증 ──────────────────────────────────────────────
# 쉼표로 구분한 허용 이메일 목록. 비우면 모든 이메일 허용.
ALLOWED_EMAILS=

# Supabase Auth 없이 로컬 개발용 매직링크를 사용할지 여부.
# true이면 로그인 링크가 메일 대신 API 응답/서버 로그로 출력된다.
AUTH_DEV_MODE=true

# 세션 유효 기간(일)
SESSION_TTL_DAYS=30

# ── 수집 ──────────────────────────────────────────────
# 스케줄러/워커 엔드포인트 보호용 공유 비밀 (POST /api/v1/internal/* 호출 시 필요)
INTERNAL_API_SECRET=dev-internal-secret

# 크롤링 User-Agent에 붙는 식별자 (비우면 myportal-bot/0.1)
CRAWL_USER_AGENT=

# JS로 목록을 채우는 사이트 수집용 헤드리스 브라우저 실행 파일 경로.
# 비우면 로컬은 시스템 Chrome을 사용하고, Vercel 같은 서버리스 환경에서는
# @sparticuz/chromium이 자동 적용된다. 둘 다 없으면 `pnpm playwright install chromium`.
CHROMIUM_PATH=

# LLM 기반 추출 명세 생성을 위해 예약된 값 (현재 코드에서는 사용되지 않음).
# 지금은 항상 DOM 휴리스틱(generateSpec)으로만 명세를 생성하며, 값을 채워도 동작은 바뀌지 않는다.
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# ── 다이제스트 메일 ────────────────────────────────────
# SMTP가 설정되지 않으면 다이제스트는 digest_runs에 'queued'로 기록되고
# 본문은 미리보기 API로 확인할 수 있다.
SMTP_URL=
MAIL_FROM=myportal <no-reply@myportal.local>
