{
  "name": "myportal-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/server/scripts/migrate.ts",
    "db:seed": "tsx src/server/scripts/seed.ts",
    "crawl:once": "tsx src/server/scripts/crawl-tick.ts",
    "crawl:watch": "tsx src/server/scripts/crawl-tick.ts --watch"
  },
  "dependencies": {
    "@myportal/api-contracts": "workspace:*",
    "@myportal/myportal-api-client": "workspace:*",
    "@ttoltori/api-client-core": "workspace:*",
    "@ttoltori/database": "workspace:*",
    "@ttoltori/hono-api-kit": "workspace:*",
    "hono": "^4.6.0",
    "linkedom": "^0.18.0",
    "next": "^15.1.0",
    "nodemailer": "^6.9.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.2",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
